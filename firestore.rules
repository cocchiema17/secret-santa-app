rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Profili utente
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // Creazione consentita solo se punti = 0 e non admin
      allow create: if isOwner(userId)
        && request.resource.data.points == 0
        && request.resource.data.isAdmin == false;

      // Aggiornamento consentito solo al proprietario, vietando la modifica di points e isAdmin
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points', 'isAdmin']);
    }

    // Abbinamenti segreti: BLINDATI (solo Cloud Functions con Admin SDK)
    match /secrets/{userId} {
      allow read, write: if false;
    }

    // Sfide giornaliere: lettura per tutti i loggati, scrittura solo admin
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Stato globale del gioco (es. estrazione effettuata)
    match /gameConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}